---
import { cn } from '@/lib/cn'

interface Props {
  class?: string
  download?: string
  href: string
  label: string
  variant?: 'primary' | 'secondary'
}

const {
  class: className = '',
  download,
  href,
  label,
  variant = 'primary',
} = Astro.props

const base =
  'inline-flex py-2 items-center justify-center gap-2 rounded-md px-6 font-semibold duration-300 transition-[shadow, transform] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground hover:shadow-xl shadow-black/15 hover:-translate-y-0.5 hover:scale-101'

const variants = {
  primary: 'bg-primary text-white hover:bg-black',
  secondary: 'border bg-white text-primary hover:bg-background',
} as const

const classes = cn(base, variants[variant], className)
---

<a href={href} class={classes} download={download}>
  {label}
  <slot />
</a>
