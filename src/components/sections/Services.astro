---
import { Icon } from 'astro-icon/components'
import SectionIntro from '@/components/blocks/SectionIntro.astro'
import Container from '@/components/layout/Container.astro'
import Card from '@/components/ui/Card.astro'
import { services } from '@/lib/content'
---

<section
  id="services"
  class="py-12 lg:py-16"
  aria-labelledby="services-title"
  data-services-carousel
>
  <Container>
    <div
      class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-center md:justify-between"
    >
      <SectionIntro
        id="services-title"
        label="What I Do"
        title="Full-stack to <span>Product</span>, built for <span>Performance</span>."
      >
        Interfaces, APIs, and platforms shaped around real users and measurable
        Core Web Vitals.
      </SectionIntro>

      <div class="hidden md:flex items-center gap-3">
        <button
          type="button"
          class="flex size-11 items-center justify-center rounded-full border border-muted text-foreground transition-shadow focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground hover:shadow-lg duration-300 shadow-muted cursor-pointer"
          aria-label="Previous service"
          data-services-prev
        >
          <Icon name="coolicons:chevron-left" class="size-5" />
        </button>
        <button
          type="button"
          class="flex size-11 items-center justify-center rounded-full border border-muted text-foreground transition-shadow focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground hover:shadow-lg duration-300 shadow-muted cursor-pointer"
          aria-label="Next service"
          data-services-next
        >
          <Icon name="coolicons:chevron-right" class="size-5" />
        </button>
      </div>
    </div>

    <div class="mt-6 md:mt-10 min-w-0" data-services-embla>
      <div class="overflow-hidden pb-7" data-services-viewport>
        <ul
          class="flex gap-4 touch-pan-y touch-pinch-zoom py-1"
          data-services-container
        >
          {services.map((service, index) => (
            <li
              class="min-w-0 shrink-0 grow-0 basis-[min(20rem,85%)] sm:basis-[calc((100%-1rem)/2)] lg:basis-[calc((100%-3rem)/3)]"
              data-services-slide
            >
              <Card activeToBrand class="h-full justify-start gap-0">
                <p class="font-semibold text-muted-foreground text-xs tracking-[0.18em] transition-colors duration-200 group-data-active:text-muted">
                  {String(index + 1).padStart(2, '0')}
                </p>
                <h3 class="mt-5 font-bold font-heading text-2xl text-primary tracking-tight transition-colors duration-200 group-data-active:text-white">
                  {service.title}
                </h3>
                <p class="mt-4 text-secondary transition-colors duration-200 group-data-active:text-white/90">
                  {service.description}
                </p>
              </Card>
            </li>
          ))}
        </ul>
      </div>

      <nav
        class="mt-2 flex flex-wrap justify-center gap-x-3 sm:mt-6"
        aria-label="Service slides"
        data-services-dots
      >
        {services.map((service, index) => (
          <button
            type="button"
            class="size-3 rounded-full bg-muted transition-[transform,background-color] duration-200 focus-visible:outline-2 focus-visible:outline-foreground focus-visible:outline-offset-2 data-active:scale-125 data-active:bg-brand"
            aria-label={`Go to ${service.title}`}
            aria-current={index === 0 ? 'true' : undefined}
            data-services-dot
            data-index={index}
          />
        ))}
      </nav>
    </div>
  </Container>
</section>

<script>
import EmblaCarousel from 'embla-carousel'
import Autoplay from 'embla-carousel-autoplay'

const root = document.querySelector<HTMLElement>('[data-services-carousel]')
const viewport = root?.querySelector<HTMLElement>('[data-services-viewport]')
const prevButton = root?.querySelector<HTMLButtonElement>(
  '[data-services-prev]'
)
const nextButton = root?.querySelector<HTMLButtonElement>(
  '[data-services-next]'
)
const dots = [
  ...(root?.querySelectorAll<HTMLButtonElement>('[data-services-dot]') ?? []),
]

if (root && viewport && prevButton && nextButton) {
  const cards = [...root.querySelectorAll<HTMLElement>('[data-services-slide]')]
    .map((slide) => slide.firstElementChild)
    .filter((card): card is HTMLElement => card instanceof HTMLElement)

  const embla = EmblaCarousel(
    viewport,
    {
      align: 'start',
      containScroll: 'trimSnaps',
      slidesToScroll: 1,
    },
    [
      Autoplay({
        delay: 4500,
        stopOnInteraction: false,
        stopOnMouseEnter: true,
      }),
    ]
  )

  const getVisibleCount = () => {
    if (window.matchMedia('(min-width: 1024px)').matches) return 3
    if (window.matchMedia('(min-width: 640px)').matches) return 2
    return 1
  }

  const getActiveSlideIndex = () => {
    const selected = embla.selectedScrollSnap()
    const visibleCount = getVisibleCount()
    const slideCount = embla.slideNodes().length

    // Odd visible set (e.g. 3 on lg): highlight the center card.
    // Even or single (sm / mobile): highlight the first visible card.
    const offset = visibleCount % 2 === 1 ? Math.floor(visibleCount / 2) : 0
    return Math.min(selected + offset, slideCount - 1)
  }

  const syncUi = () => {
    const selected = embla.selectedScrollSnap()
    const activeSlide = getActiveSlideIndex()

    for (const [index, dot] of dots.entries()) {
      const isActive = index === selected
      dot.toggleAttribute('data-active', isActive)
      if (isActive) dot.setAttribute('aria-current', 'true')
      else dot.removeAttribute('aria-current')
    }

    for (const [index, card] of cards.entries()) {
      card.toggleAttribute('data-active', index === activeSlide)
    }
  }

  prevButton.addEventListener('click', () => embla.scrollPrev(), false)
  nextButton.addEventListener('click', () => embla.scrollNext(), false)

  for (const dot of dots) {
    dot.addEventListener(
      'click',
      () => embla.scrollTo(Number(dot.dataset.index)),
      false
    )
  }

  embla.on('select', syncUi)
  embla.on('reInit', syncUi)
  window.addEventListener('resize', syncUi, { passive: true })
  syncUi()
}
</script>
