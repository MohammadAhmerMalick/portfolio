---
interface Props {
  id: string
  label: string
  title: string
}

const { id, label, title } = Astro.props
---

<div class="max-w-xl text-center md:text-left mx-auto md:mx-0">
  <p
    class="flex items-center justify-center gap-2 text-xl font-semibold text-foreground md:justify-start"
  >
    <span
      class="size-1.5 shrink-0 rounded-full bg-brand"
      aria-hidden="true"
    ></span>
    {label}
  </p>
  <h2
    id={id}
    class="mt-2 text-3xl font-bold leading-tight tracking-tight md:text-4xl [&_span]:text-brand"
    set:html={title}
  />
  <p class="mt-5 leading-relaxed text-secondary">
    <slot />
  </p>
</div>
