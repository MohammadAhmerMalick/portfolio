---
import Card from '@/components/ui/Card.astro'
import { experience } from '@/lib/content'
---

<div class="grid min-h-72" data-experience-details>
  {experience.map((exp, index) => (
    <div
      class="experience-panel col-start-1 row-start-1 transition-opacity duration-300 ease-out"
      data-experience-panel
      data-index={index}
      data-active={index === 0 ? '' : undefined}
      aria-hidden={index !== 0}
    >
      <Card
        theme="default"
        grid
        class="h-full min-h-72 gap-6"
        ringClass="shadow-brand/2 bottom-0 top-auto"
      >
        <div class="space-y-6">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="flex min-w-0 items-center gap-3">
              <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-muted font-bold font-heading text-xs tracking-tight">
                {exp.mark}
              </span>
              <div class="min-w-0">
                <p class="font-semibold text-sm tracking-wide">{exp.company}</p>
                <h3 class="mt-0.5 font-bold font-heading text-2xl tracking-tight sm:text-3xl">
                  {exp.role}
                </h3>
              </div>
            </div>
            <p class="font-medium text-xs leading-relaxed sm:text-right sm:text-sm">
              <span class="block">{exp.dates}</span>
              <span class="mt-0.5 block">{exp.location}</span>
            </p>
          </div>

          <ul class="space-y-3">
            {exp.bullets.map((bullet) => (
              <li class="flex gap-2.5">
                <span
                  class="mt-2.25 size-1.5 shrink-0 rounded-full bg-brand"
                  aria-hidden="true"
                />
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        </div>
      </Card>
    </div>
  ))}
</div>

<style>
.experience-panel {
  opacity: 0;
  pointer-events: none;
  max-height: 300px;
}

.experience-panel[data-active] {
  opacity: 1;
  pointer-events: auto;
  max-height: unset;
}
</style>
