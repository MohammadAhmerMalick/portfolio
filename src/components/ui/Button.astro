---
import { cn } from '@/lib/cn'

interface Props {
  class?: string
  download?: string
  href: string
  label: string
  variant?: 'primary' | 'secondary'
}

const {
  class: className = '',
  download,
  href,
  label,
  variant = 'primary',
} = Astro.props

const base =
  'inline-flex py-2 items-center justify-center gap-2 rounded-md px-6 font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground'

const variants = {
  primary: 'bg-primary text-white hover:bg-border',
  secondary:
    'border border-[#E4E7EC] bg-white text-primary hover:bg-[#F5F6F8]',
} as const

const classes = cn(base, variants[variant], className)
---

<a href={href} class={classes} download={download}>
  {label}
  <slot />
</a>
