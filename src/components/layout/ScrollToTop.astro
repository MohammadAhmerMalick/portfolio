---
import { Icon } from 'astro-icon/components'
---

<a
  href="#top"
  data-scroll-top
  class="fixed right-6 bottom-6 z-40 flex size-11 translate-y-10 items-center justify-center rounded-full border border-muted bg-muted/20 text-foreground opacity-0 shadow-brand/40 pointer-events-none  duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground hover:shadow-lg data-visible:opacity-100 data-visible:translate-y-0 data-visible:pointer-events-auto hover:bg-primary/80 hover:text-white  hover:border-brand/50"
  aria-label="Scroll to top"
  tabindex="-1"
>
  <Icon name="coolicons:chevron-up" class="size-5" />
</a>

<script>
const button = document.querySelector('[data-scroll-top]')

if (button instanceof HTMLAnchorElement) {
  const threshold = 400

  const update = () => {
    const visible = window.scrollY > threshold
    button.toggleAttribute('data-visible', visible)
    button.setAttribute('aria-hidden', String(!visible))
    button.tabIndex = visible ? 0 : -1
  }

  update()
  document.addEventListener('scroll', update, { passive: true })
}
</script>
