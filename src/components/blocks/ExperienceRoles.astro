---
import Card from '@/components/ui/Card.astro'
import { experience } from '@/lib/content'
---

<ol class="relative flex flex-col gap-5" data-experience-roles>
  {experience.map((role, index) => {
    return (
      <li data-experience-trigger data-index={index}>
        <Card hoverToBrand={true} active={index === 0}>
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="flex min-w-0 items-center gap-3">
              <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-muted font-bold font-heading text-lg tracking-tight transition-colors duration-300 group-hover:bg-white/15 group-hover:text-white group-data-active:bg-white/15 group-data-active:text-white">
                {role.mark}
              </span>
              <div>
                <p class="font-semibold text-sm transition-colors duration-300 group-hover:text-white group-data-active:text-white">
                  {role.company}
                </p>
                <h3 class="mt-0.5 font-bold font-heading text-lg tracking-tight transition-colors duration-300 group-hover:text-white group-data-active:text-white">
                  {role.role}
                </h3>
              </div>
            </div>
            <p class="text-right font-medium text-xs leading-relaxed transition-colors duration-300 group-hover:text-white group-data-active:text-white sm:text-sm">
              <span class="block">{role.dates}</span>
              <span class="mt-0.5 block">{role.location}</span>
            </p>
          </div>
          <ul class="mt-5 space-y-2.5">
            {role.bullets?.slice(0, 2).map((bullet) => (
              <li class="flex gap-2.5 leading-6 transition-colors duration-300 group-hover:text-white group-data-active:text-white">
                <span
                  class="mt-2 size-1.5 shrink-0 rounded-full bg-brand transition-colors duration-300 group-hover:bg-white group-data-active:bg-white"
                  aria-hidden="true"
                />
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        </Card>
      </li>
    )
  })}
</ol>
