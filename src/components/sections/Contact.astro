---
import { Icon } from 'astro-icon/components'
import SectionIntro from '@/components/blocks/SectionIntro.astro'
import Container from '@/components/layout/Container.astro'
import Card from '@/components/ui/Card.astro'
import { contact, contactChannels, hero } from '@/lib/content'

const secondaryChannels = contactChannels.filter(
  (channel) => channel.label !== 'Email'
)
---

<section id="contact" class="py-12 lg:py-16" aria-labelledby="contact-title">
  <Container>
    <div class="flex flex-col gap-8">
      <div
        class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between"
      >
        <SectionIntro
          id="contact-title"
          label="Contact"
          title="Let's work <span>Together</span>."
        >
          {hero.availability}
          for new opportunities and interesting projects. Prefer email — or pick
          another direct line below.
        </SectionIntro>

        <div
          class="inline-flex w-fit shrink-0 items-center gap-2 rounded-full border border-muted px-4 py-2 text-sm font-medium text-primary shadow shadow-muted mx-auto md:mx-0"
        >
          <span
            class="size-2 shrink-0 rounded-full bg-brand"
            aria-hidden="true"
          ></span>
          {hero.availability}
          <span class="text-muted-foreground">·</span>
          <span class="text-muted-foreground">{hero.location}</span>
        </div>
      </div>

      <Card
        theme="brand"
        grid
        class="gap-8 lg:gap-10 lg:p-10 shadow-xl shadow-brand/20"
      >
        <div>
          <p class="text-xs font-bold tracking-[0.18em] text-muted uppercase">
            Direct line
          </p>
          <a
            href={`mailto:${contact.email}`}
            class="group mt-4 block break-all font-heading text-3xl sm:text-4xl md:5xl font-bold leading-[1.1] tracking-tight focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
          >
            <span class="underline-offset-4 group-hover:underline">
              {contact.email}
            </span>
          </a>
          <div class="flex justify-between gap-3 items-end flex-wrap">
            <p class="mt-3 max-w-md leading-6 text-muted">
              Fastest way to reach me. Copy the address or open your mail client
              in one click.
            </p>

            <div class="flex flex-wrap gap-3">
              <button
                type="button"
                class="inline-flex min-h-11 items-center gap-2 rounded-md border border-white/15 bg-black/20 px-5 font-semibold text-white duration-200 hover:bg-white/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                data-copy-email
                data-email={contact.email}
              >
                <Icon name="coolicons:copy" class="size-4" data-copy-icon />
                <Icon
                  name="coolicons:check"
                  class="hidden size-4"
                  data-copied-icon
                />
                <span data-copy-label>Copy email</span>
              </button>
              <a
                href={`mailto:${contact.email}`}
                class="inline-flex min-h-11 items-center gap-2 rounded-md bg-white px-5 font-semibold text-primary duration-200 hover:bg-white/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
              >
                Write email
                <Icon name="coolicons:arrow-right" class="size-4" />
              </a>
            </div>
          </div>
        </div>

        <div
          class="grid gap-3 border-t border-white/25 pt-6 sm:grid-cols-2 lg:grid-cols-4"
        >
          {secondaryChannels.map((channel) => (
            <a
              href={channel.href}
              {...(channel.external
                ? { rel: 'noreferrer noopener', target: '_blank' }
                : {})}
              class="group flex min-h-20 items-center gap-3 rounded-2xl border border-white/15 bg-black/20 px-4 py-3 duration-200 hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-2"
            >
              <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-white/12 text-white">
                <Icon name={channel.icon} class="size-5" />
              </span>
              <span class="min-w-0">
                <span class="block font-semibold text-white tracking-widest">
                  {channel.label}
                </span>
                <span class="mt-0.5 block truncate text-white">
                  {channel.detail}
                </span>
              </span>
              <Icon
                name="coolicons:arrow-right"
                class="ml-auto size-4 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:text-white"
              />
            </a>
          ))}
        </div>
      </Card>
    </div>
  </Container>
</section>

<script>
const button = document.querySelector('[data-copy-email]')

if (button instanceof HTMLButtonElement) {
  const label = button.querySelector('[data-copy-label]')
  const copyIcon = button.querySelector('[data-copy-icon]')
  const copiedIcon = button.querySelector('[data-copied-icon]')
  const email = button.dataset.email ?? ''
  let resetTimer = 0

  const setCopied = (copied: boolean) => {
    if (label) label.textContent = copied ? 'Copied' : 'Copy email'
    copyIcon?.classList.toggle('hidden', copied)
    copiedIcon?.classList.toggle('hidden', !copied)
  }

  button.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(email)
      setCopied(true)
      window.clearTimeout(resetTimer)
      resetTimer = window.setTimeout(() => setCopied(false), 1800)
    } catch {
      window.location.href = `mailto:${email}`
    }
  })
}
</script>
