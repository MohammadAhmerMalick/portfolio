---
import { Icon } from 'astro-icon/components'
import Container from '@/components/layout/Container.astro'
import SkipToContent from '@/components/layout/SkipToContent.astro'
import Button from '@/components/ui/Button.astro'
import { contact, contactChannels, hero, resumePath } from '@/lib/content'
import { site } from '@/lib/site'

const links = [
  { href: '#services', icon: 'coolicons:layers', label: 'What I Do' },
  { href: '#work', icon: 'coolicons:component', label: 'Work' },
  { href: '#experience', icon: 'coolicons:kanban', label: 'Experience' },
  { href: '#skills', icon: 'coolicons:file-code', label: 'Skills' },
  { href: '#contact', icon: 'coolicons:mail', label: 'Contact' },
] as const

const quickLinks = contactChannels.filter((channel) =>
  ['Email', 'LinkedIn', 'GitHub', 'WhatsApp'].includes(channel.label)
)
---

<SkipToContent />

<header
  class="sticky top-0 z-50 border-b border-white/70 bg-white/70 shadow-md shadow-brand/5 backdrop-blur-md"
>
  <Container>
    <div class="flex h-17 items-center justify-between gap-4 lg:h-19">
      <a
        href="#top"
        aria-label={site.name}
        class="inline-flex min-w-0 items-center rounded-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground"
      >
        <span>
          <span
            class="block truncate font-heading text-xl leading-none font-semibold text-primary"
          >
            {site.name}
          </span>
          <span
            class="mt-1 block text-sm leading-none font-medium tracking-[.15em] text-secondary/80"
          >
            {site.jobTitle}
          </span>
        </span>
      </a>

      <div class="hidden items-center gap-2 lg:flex">
        <nav aria-label="Primary">
          <ul class="flex items-center">
            {links.map((link) => (
              <li>
                <a
                  href={link.href}
                  data-nav
                  class="group relative inline-flex items-center rounded px-3 py-2 text-sm font-medium text-primary transition-colors duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground data-active:text-foreground"
                >
                  {link.label}
                  <span class="absolute inset-x-3 bottom-1.5 h-0.5 origin-center scale-x-0 rounded-full bg-primary transition-transform duration-300 group-data-active:scale-x-100" />
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <Button
          href={resumePath}
          label="Download resume"
          variant="primary"
          download="Mohammad-Ahmer-Malick-Resume.pdf"
        >
          <Icon name="coolicons:download" class="size-5" />
        </Button>
      </div>

      <button
        type="button"
        class="flex size-11 shrink-0 items-center justify-center rounded-md border border-muted bg-white/50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground lg:hidden"
        aria-controls="mobile-nav"
        aria-expanded="false"
        data-nav-toggle
      >
        <Icon name="coolicons:menu" class="size-7" />
        <span class="sr-only">Open menu</span>
      </button>
    </div>
  </Container>
</header>

<div
  id="mobile-nav"
  class="group/drawer pointer-events-none fixed inset-0 z-50 data-open:pointer-events-auto lg:hidden"
  inert
>
  <button
    type="button"
    class="absolute inset-0 bg-secondary/25 opacity-0 transition-opacity duration-300 group-data-open/drawer:opacity-100"
    data-nav-close
    aria-label="Close menu"
  />
  <div
    class="absolute inset-y-0 right-0 flex w-[min(22rem,calc(100vw-1.25rem))] translate-x-full flex-col overflow-y-auto rounded-l-3xl border-l border-muted/80 bg-slate-50 shadow-[-24px_0_48px_rgb(18_20_28/0.1)] transition-transform duration-350 ease-out group-data-open/drawer:translate-x-0"
  >
    <div class="border-b border-muted/70 bg-white px-6 pt-6 pb-5">
      <div class="flex items-start justify-between gap-4">
        <div class="min-w-0">
          <p
            class="text-xs font-semibold tracking-[0.18em] text-muted-foreground uppercase"
          >
            Menu
          </p>
          <p
            class="mt-2 truncate font-heading text-lg font-semibold tracking-tight text-primary"
          >
            {site.name}
          </p>
          <p class="mt-1 text-sm text-muted-foreground">{site.jobTitle}</p>
        </div>
        <button
          type="button"
          class="flex size-11 shrink-0 items-center justify-center rounded-full border border-muted bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground"
          data-nav-close
        >
          <Icon name="coolicons:close" class="size-7" />
          <span class="sr-only">Close menu</span>
        </button>
      </div>

  
    </div>

    <nav aria-label="Primary" class="pl-4 pt-5">
      <p
        class="mb-3 px-3 text-xs font-semibold tracking-[0.18em] text-muted-foreground uppercase"
      >
        Navigate
      </p>
      <ul class="flex flex-col gap-1.5">
        {links.map((link, index) => (
          <li>
            <a
              href={link.href}
              data-nav
              class="group flex h-14 w-full items-center gap-3 rounded-s-full border border-transparent  active:bg-white px-2 font-medium text-primary transition-[background-color,border-color,color,box-shadow,transform] duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground   data-active:bg-white  data-active:shadow-md data-active:shadow-brand/10"
            >
              <span
                class="grid size-9 shrink-0 place-items-center rounded-xl border border-slate-50 text-muted-foreground transition-colors duration-300 group-data-active:bg-slate-100 group-data-active:border-brand/10 "
                aria-hidden="true"
              >
                <Icon name={link.icon} class="size-4.5" />
              </span>
              <span class="min-w-0 flex-1 text-left truncate">
                  {link.label}
              </span>
              <Icon
                name="coolicons:chevron-right"
                class="size-5 shrink-0 text-muted-foreground/70 transition-transform duration-300 group-data-active:translate-x-0.5 group-data-active:text-brand"
              />
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mt-auto px-4 pt-6 pb-6">
      <div
        class="rounded-2xl border border-muted bg-white p-4 shadow-sm"
      >
        <p
          class="text-xs font-semibold tracking-[0.18em] text-muted-foreground uppercase"
        >
          Get in touch
        </p>
        <a
          href={`mailto:${contact.email}`}
          class="mt-3 block truncate text-sm font-medium text-primary underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground"
        >
          {contact.email}
        </a>
        <div class="mt-4 flex flex-wrap gap-2">
          {quickLinks.map((channel) => (
            <a
              href={channel.href}
              class="inline-flex size-11 items-center justify-center rounded-full border border-muted bg-slate-50 text-primary transition-colors duration-200 hover:border-brand/20 hover:bg-brand/5 hover:text-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground"
              aria-label={channel.label}
              {...(channel.external
                ? { rel: 'noopener noreferrer', target: '_blank' }
                : {})}
            >
              <Icon name={channel.icon} class="size-5" />
            </a>
          ))}
        </div>
      </div>

      <Button
        href={resumePath}
        label="Download resume"
        variant="primary"
        class="mt-4 min-h-12 w-full"
        download="Mohammad-Ahmer-Malick-Resume.pdf"
      >
        <Icon name="coolicons:download" class="size-5" />
      </Button>
    </div>
  </div>
</div>

<script>
const drawer = document.querySelector('#mobile-nav')
const toggle = document.querySelector('[data-nav-toggle]')

if (drawer instanceof HTMLElement && toggle instanceof HTMLButtonElement) {
  const setOpen = (open: boolean) => {
    drawer.toggleAttribute('data-open', open)
    drawer.inert = !open
    toggle.setAttribute('aria-expanded', String(open))
    document.documentElement.classList.toggle('overflow-hidden', open)
  }

  toggle.addEventListener('click', () => setOpen(true))

  drawer.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return
    if (event.target.closest('[data-nav-close], a')) setOpen(false)
  })

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false)
  })
}

const links = [...document.querySelectorAll('[data-nav]')]
const sections = ['services', 'work', 'experience', 'skills', 'contact']
  .map((id) => document.getElementById(id))
  .filter((section) => section instanceof HTMLElement)

const setActive = () => {
  const offset = 100
  let currentId = ''

  for (const section of sections) {
    if (section.getBoundingClientRect().top - offset <= 0)
      currentId = section.id
  }

  for (const link of links) {
    link.toggleAttribute(
      'data-active',
      currentId !== '' && link.getAttribute('href') === `#${currentId}`
    )
  }
}

setActive()
document.addEventListener('scroll', setActive, { passive: true })

</script>
